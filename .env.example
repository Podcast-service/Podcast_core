# Copy this file to .env before running docker compose:
#   cp .env.example .env
#
# Local development defaults are intentionally usable out of the box.
# For a real server, replace passwords/secrets and remove the dev profile.

# Application
PODCAST_SPRING_PROFILES_ACTIVE=docker,dev
PODCAST_SERVER_PORT=8082
PODCAST_SERVER_SERVLET_CONTEXT_PATH=/podcast/v1
PODCAST_APP_PORT=8082
PODCAST_DEV_SEED_ENABLED=true

# PostgreSQL
PODCAST_DB=podcast_db
PODCAST_DB_USER=podcast_user
PODCAST_DB_PASSWORD=podcast_pass
PODCAST_DB_PORT=5432
PODCAST_DB_URL=jdbc:postgresql://postgres:5432/podcast_db

# Kafka
PODCAST_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
PODCAST_KAFKA_CONSUMER_GROUP=podcast-service
PODCAST_KAFKA_TOPIC_USER_REGISTER=podcast.user.register
PODCAST_KAFKA_TOPIC_MEDIA_UPLOAD=media.upload
PODCAST_KAFKA_TOPIC_MEDIA_WORKER=media.worker
PODCAST_KAFKA_TOPIC_MEDIA_SUBTITLE=media.subtitle
PODCAST_KAFKA_TOPIC_TTS_START=tts.start
PODCAST_KAFKA_TOPIC_TTS_FAILED=tts.failed
PODCAST_KAFKA_TOPIC_PODCAST_ACTIVITY_EVENTS=podcast.activity.events.v1
PODCAST_KAFKA_TOPIC_PODCAST_CONTENT_EVENTS=podcast.content.events.v1
PODCAST_KAFKA_TOPIC_PODCAST_SEARCH_EVENTS=podcast.search.events.v1
PODCAST_KAFKA_RETRY_BACKOFF_MS=1000
PODCAST_KAFKA_RETRY_MAX_ATTEMPTS=3
PODCAST_KAFKA_DLT_SUFFIX=.DLT
PODCAST_KAFKA_DLT_TOPIC_PODCAST_ACTIVITY_EVENTS=podcast.activity.events.v1.DLT
PODCAST_KAFKA_DLT_TOPIC_PODCAST_CONTENT_EVENTS=podcast.content.events.v1.DLT
PODCAST_KAFKA_DLT_TOPIC_PODCAST_SEARCH_EVENTS=podcast.search.events.v1.DLT
PODCAST_KAFKA_PRODUCER_ENABLED=false
PODCAST_KAFKA_INTERNAL_PORT=9092
PODCAST_KAFKA_EXTERNAL_PORT=9094
PODCAST_KAFKA_EXTERNAL_HOST=host.docker.internal
PODCAST_KAFKA_AUTO_CREATE_TOPICS_ENABLE=true

# Recommendation outbox events
# Disabled by default; enables writing recommendation MVP events to outbox_events.
PODCAST_RECOMMENDATION_EVENTS_ENABLED=false

# Outbox publisher
# Disabled by default; requires PODCAST_KAFKA_PRODUCER_ENABLED=true to send messages.
PODCAST_OUTBOX_PUBLISHER_ENABLED=false
PODCAST_OUTBOX_BATCH_SIZE=100
PODCAST_OUTBOX_PUBLISH_DELAY_MS=3000
PODCAST_OUTBOX_MAX_RETRY_ATTEMPTS=10
PODCAST_OUTBOX_PROCESSING_TIMEOUT_MS=600000
PODCAST_OUTBOX_SEND_TIMEOUT_MS=10000
# OpenRouter summary generation
# Disabled by default. Put real API keys only in local/secret env files, never in git.
PODCAST_OPENROUTER_ENABLED=false
PODCAST_OPENROUTER_API_KEY=
PODCAST_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PODCAST_OPENROUTER_MODEL=openrouter/free
PODCAST_OPENROUTER_SITE_URL=https://example.local
PODCAST_OPENROUTER_APP_TITLE=Podcast Summary Service
PODCAST_OPENROUTER_TEMPERATURE=0.3
PODCAST_OPENROUTER_MAX_TOKENS=500
PODCAST_OPENROUTER_CONNECT_TIMEOUT=3s
PODCAST_OPENROUTER_READ_TIMEOUT=60s
PODCAST_OPENROUTER_MAX_ATTEMPTS=3
PODCAST_OPENROUTER_RETRY_BACKOFF=500ms
PODCAST_SUMMARY_DIRECT_MAX_CHARS=50000
PODCAST_SUMMARY_CHUNK_SIZE_CHARS=30000
PODCAST_SUMMARY_SYSTEM_PROMPT=
PODCAST_SUMMARY_DIRECT_PROMPT=
PODCAST_SUMMARY_CHUNK_PROMPT=
PODCAST_SUMMARY_FINAL_PROMPT=

# Kafka UI
PODCAST_KAFKA_UI_PORT=8081

# JWT auth
# Local dev value must match scripts/generate-dev-token.*.
# Production value must come from a secret manager and must not be committed.
PODCAST_AUTH_SERVICE_BASE_URL=http://auth-service:8080
PODCAST_AUTH_SERVICE_CONNECT_TIMEOUT=2s
PODCAST_AUTH_SERVICE_READ_TIMEOUT=5s
PODCAST_ACCESS_TOKEN_SECRET=dev-access-token-secret-change-me
PODCAST_ACCESS_TOKEN_ISSUER=auth-service
PODCAST_AUTH_ENABLED=true

# Browser clients allowed to call the API.
# Use comma-separated origins, no wildcard.
PODCAST_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8082

# Swagger UI loads the dev OpenAPI document from this URL.
PODCAST_SWAGGER_ENABLED=true
PODCAST_SWAGGER_OPENAPI_URL=openapi/podcast-service-dev.yaml
