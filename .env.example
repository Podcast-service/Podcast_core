# Copy this file to .env before running docker compose:
#   cp .env.example .env
#
# Local development defaults are intentionally usable out of the box.
# For a real server, replace passwords/secrets and remove the dev profile.

# Application
PODCAST_SPRING_PROFILES_ACTIVE=docker,dev
PODCAST_SERVER_PORT=8082
PODCAST_SERVER_SERVLET_CONTEXT_PATH=/podcast/v1
PODCAST_APP_PORT=8082
PODCAST_DEV_SEED_ENABLED=true

# PostgreSQL
PODCAST_DB=podcast_db
PODCAST_DB_USER=podcast_user
PODCAST_DB_PASSWORD=podcast_pass
PODCAST_DB_PORT=5432
PODCAST_DB_URL=jdbc:postgresql://postgres:5432/podcast_db

# Kafka
PODCAST_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
PODCAST_KAFKA_CONSUMER_GROUP=podcast-service
PODCAST_KAFKA_TOPIC_USERS=podcasts.users
PODCAST_KAFKA_TOPIC_PODCASTS=podcasts.podcasts
PODCAST_KAFKA_INTERNAL_PORT=9092
PODCAST_KAFKA_EXTERNAL_PORT=9094
PODCAST_KAFKA_EXTERNAL_HOST=host.docker.internal
PODCAST_KAFKA_AUTO_CREATE_TOPICS_ENABLE=true

# Kafka UI
PODCAST_KAFKA_UI_PORT=8081

# JWT auth
# Local dev value must match scripts/generate-dev-token.*.
# Production value must come from a secret manager and must not be committed.
PODCAST_ACCESS_TOKEN_SECRET=dev-access-token-secret-change-me
PODCAST_ACCESS_TOKEN_ISSUER=auth-service
PODCAST_AUTH_ENABLED=true

# Browser clients allowed to call the API.
# Use comma-separated origins, no wildcard.
PODCAST_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8082

# Swagger UI loads the dev OpenAPI document from this URL.
PODCAST_SWAGGER_ENABLED=true
PODCAST_SWAGGER_OPENAPI_URL=/openapi/podcast-service-dev.yaml
