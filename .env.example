# Copy this file to .env before running docker compose:
#   cp .env.example .env
#
# Local development defaults are intentionally usable out of the box.
# For a real server, replace passwords/secrets and remove the dev profile.

# Compose
COMPOSE_PROJECT_NAME=podcast-core

# Application
SPRING_PROFILES_ACTIVE=docker,dev
SERVER_PORT=8082
APP_PORT=8082
DEV_SEED_ENABLED=true

# PostgreSQL
POSTGRES_DB=podcast_db
POSTGRES_USER=podcast_user
POSTGRES_PASSWORD=podcast_pass
POSTGRES_PORT=5432

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP=podcast-service
KAFKA_TOPIC_USERS=podcasts.users
KAFKA_TOPIC_PODCASTS=podcasts.podcasts
KAFKA_INTERNAL_PORT=9092
KAFKA_EXTERNAL_PORT=9094
KAFKA_EXTERNAL_HOST=host.docker.internal
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true

# Kafka UI
KAFKA_UI_PORT=8081

# JWT auth
# Local dev value must match scripts/generate-dev-token.*.
# Production value must come from a secret manager and must not be committed.
ACCESS_TOKEN_SECRET=dev-access-token-secret-change-me
ACCESS_TOKEN_ISSUER=auth-service
AUTH_ENABLED=true

# Browser clients allowed to call the API.
# Use comma-separated origins, no wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8082
